{
  "name": "@michaelthielemann/kestrel-events-direct",
  "version": "6.0.0",
  "description": "Inline event delivery: subscribes event-trigger pipelines to events@1 and runs them within the emitting request.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./module.ts",
    "./impl": "./impl.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/module.d.ts",
        "default": "./dist/module.js"
      },
      "./impl": {
        "types": "./dist/impl.d.ts",
        "default": "./dist/impl.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@michaelthielemann/kestrel": "workspace:^",
    "@michaelthielemann/kestrel-contracts": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@michaelthielemann/kestrel": "workspace:*",
    "@michaelthielemann/kestrel-contracts": "workspace:*",
    "@michaelthielemann/kestrel-events-inmemory": "workspace:*",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/events-direct"
  },
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues"
}
