{
  "name": "@michaelthielemann/kestrel-delivery-static",
  "version": "5.0.3",
  "description": "Renders published documents per locale via renderer@1, stores them in blobstore@1 and tracks a publish status.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./module.ts",
    "./impl": "./impl.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/module.d.ts",
        "default": "./dist/module.js"
      },
      "./impl": {
        "types": "./dist/impl.d.ts",
        "default": "./dist/impl.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@michaelthielemann/kestrel": "workspace:^",
    "@michaelthielemann/kestrel-contracts": "workspace:^"
  },
  "dependencies": {
    "turndown": "^7.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@michaelthielemann/kestrel": "workspace:*",
    "@michaelthielemann/kestrel-content-default": "workspace:*",
    "@michaelthielemann/kestrel-contracts": "workspace:*",
    "@michaelthielemann/kestrel-site-default": "workspace:*",
    "@types/turndown": "^5.0.6",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/delivery-static"
  },
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues"
}
