{
  "name": "@michaelthielemann/kestrel-upgrade",
  "version": "5.8.0",
  "description": "The 5.8 -> 6.0 upgrade engine behind `kestrel upgrade`: check, fix, data and the offline storage migration of a database and blob copy (migrate), an exported sandbox helper and the plugin API host packages register their rules and project loader through.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./codemods": "./src/codemods.ts",
    "./hosts": "./src/hosts.ts",
    "./plugin": "./src/plugin.ts",
    "./project": "./src/project.ts",
    "./sandbox": "./src/sandbox.ts",
    "./scratch": "./src/scratch.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./codemods": {
        "types": "./dist/codemods.d.ts",
        "default": "./dist/codemods.js"
      },
      "./hosts": {
        "types": "./dist/hosts.d.ts",
        "default": "./dist/hosts.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "./project": {
        "types": "./dist/project.d.ts",
        "default": "./dist/project.js"
      },
      "./sandbox": {
        "types": "./dist/sandbox.d.ts",
        "default": "./dist/sandbox.js"
      },
      "./scratch": {
        "types": "./dist/scratch.d.ts",
        "default": "./dist/scratch.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@michaelthielemann/kestrel": "workspace:^",
    "@michaelthielemann/kestrel-contracts": "workspace:^"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@michaelthielemann/kestrel": "workspace:*",
    "@michaelthielemann/kestrel-authz-roles": "workspace:*",
    "@michaelthielemann/kestrel-backup-blobstore": "workspace:*",
    "@michaelthielemann/kestrel-blobstore-s3": "workspace:*",
    "@michaelthielemann/kestrel-contracts": "workspace:*",
    "@michaelthielemann/kestrel-content-default": "workspace:*",
    "@michaelthielemann/kestrel-delivery-static": "workspace:*",
    "@michaelthielemann/kestrel-events-direct": "workspace:*",
    "@michaelthielemann/kestrel-events-inmemory": "workspace:*",
    "@michaelthielemann/kestrel-events-queue": "workspace:*",
    "@michaelthielemann/kestrel-images-default": "workspace:*",
    "@michaelthielemann/kestrel-media-default": "workspace:*",
    "@michaelthielemann/kestrel-persistence-sqlite": "workspace:*",
    "@michaelthielemann/kestrel-renderer-plain": "workspace:*",
    "@michaelthielemann/kestrel-replication-sqlite": "workspace:*",
    "@michaelthielemann/kestrel-site-default": "workspace:*",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/upgrade"
  },
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues"
}
