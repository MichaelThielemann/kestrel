  "description": "Kestrel's stateless single-admin session/auth domain: password hashing, the signed session cookie, revocation epoch, and login-throttle pipelines.",
  "license": "Apache-2.0",
  "author": "Michael Thielemann <283621694+MichaelThielemann@users.noreply.github.com>",
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/kestrel-auth"
  },
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
