  "dependencies": {
    "@kestrel/contracts": "workspace:*",
    "@kestrel/core": "workspace:*",
    "effect": "~3.22.1"
  },
  "peerDependencies": {
    "h3": "^1.15.0 || ^2.0.0"
  },
  "devDependencies": {
    "@kestrel/access": "workspace:*",
    "@types/node": "^26.2.0",
    "h3": "^1.15.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
