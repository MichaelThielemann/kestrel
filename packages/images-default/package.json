{
  "name": "@michaelthielemann/kestrel-images-default",
  "version": "5.8.1",
  "description": "Steps images.register/generate/sync/resume/prune: image variant size registry, generation on upload, resumable sync; reads media through media@1.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./module.ts",
    "./impl": "./impl.ts",
    "./framing": "./framing.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/module.d.ts",
        "default": "./dist/module.js"
      },
      "./impl": {
        "types": "./dist/impl.d.ts",
        "default": "./dist/impl.js"
      },
      "./framing": {
        "types": "./dist/framing.d.ts",
        "default": "./dist/framing.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@michaelthielemann/kestrel": "workspace:^",
    "@michaelthielemann/kestrel-contracts": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.6.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@michaelthielemann/kestrel": "workspace:*",
    "@michaelthielemann/kestrel-contracts": "workspace:*",
    "@michaelthielemann/kestrel-media-default": "workspace:*",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/images-default"
  },
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues"
}
