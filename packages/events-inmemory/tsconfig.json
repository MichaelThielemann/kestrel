{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "composite": true
  },
  "include": [
    "."
  ],
  "exclude": [
    "dist",
    "**/*.test.ts",
    "**/*.contract.test.ts"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../contracts"
    }
  ]
}
