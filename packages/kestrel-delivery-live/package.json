{
  "name": "@kestrel/delivery-live",
  "version": "0.1.0",
  "description": "The live delivery adapter: serves published content from published_snapshots at request time (redirects, the read pipeline, and the DeliveryPort).",
  "license": "Apache-2.0",
  "author": "Michael Thielemann <283621694+MichaelThielemann@users.noreply.github.com>",
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/kestrel-delivery-live"
  },
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "@kestrel/contracts": "workspace:*",
    "@kestrel/core": "workspace:*",
    "@kestrel/publishing": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "~3.22.1"
  },
  "peerDependencies": {
    "h3": "^1.15.0 || ^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^12.11.1",
    "h3": "^1.15.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
