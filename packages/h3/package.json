{
  "name": "@michaelthielemann/kestrel-h3",
  "version": "5.0.3",
  "description": "Adapter: serves a Kestrel instance's HTTP triggers as an h3 event handler (Nuxt/Nitro).",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
