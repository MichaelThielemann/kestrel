{
  "name": "@michaelthielemann/kestrel-contracts",
  "version": "5.8.1",
  "description": "Kestrel standard contracts (persistence, authn, authz, blobstore, events, media and more) with contract test suites.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    "./*.test": null,
    "./atomic.contract.test": "./src/atomic.contract.test.ts",
    "./authn.contract.test": "./src/authn.contract.test.ts",
    "./authn.steps.contract.test": "./src/authn.steps.contract.test.ts",
    "./authz.contract.test": "./src/authz.contract.test.ts",
    "./blobstore.contract.test": "./src/blobstore.contract.test.ts",
    "./content.contract.test": "./src/content.contract.test.ts",
    "./events.contract.test": "./src/events.contract.test.ts",
    "./events.steps.contract.test": "./src/events.steps.contract.test.ts",
    "./insights.contract.test": "./src/insights.contract.test.ts",
    "./media.contract.test": "./src/media.contract.test.ts",
    "./migrations.contract.test": "./src/migrations.contract.test.ts",
    "./persistence.contract.test": "./src/persistence.contract.test.ts",
    "./renderer.contract.test": "./src/renderer.contract.test.ts",
    "./revisions.contract.test": "./src/revisions.contract.test.ts",
    "./site.contract.test": "./src/site.contract.test.ts",
    "./validate.contract.test": "./src/validate.contract.test.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./*.test": null,
      "./atomic.contract.test": {
        "types": "./dist/atomic.contract.test.d.ts",
        "default": "./dist/atomic.contract.test.js"
      },
