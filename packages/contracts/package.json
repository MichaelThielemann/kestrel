        "types": "./dist/authz.contract.test.d.ts",
        "default": "./dist/authz.contract.test.js"
      },
      "./blobstore.contract.test": {
        "types": "./dist/blobstore.contract.test.d.ts",
        "default": "./dist/blobstore.contract.test.js"
      },
      "./content.contract.test": {
        "types": "./dist/content.contract.test.d.ts",
        "default": "./dist/content.contract.test.js"
      },
      "./events.contract.test": {
        "types": "./dist/events.contract.test.d.ts",
        "default": "./dist/events.contract.test.js"
      },
      "./events.steps.contract.test": {
        "types": "./dist/events.steps.contract.test.d.ts",
        "default": "./dist/events.steps.contract.test.js"
      },
      "./insights.contract.test": {
        "types": "./dist/insights.contract.test.d.ts",
        "default": "./dist/insights.contract.test.js"
      },
      "./media.contract.test": {
        "types": "./dist/media.contract.test.d.ts",
        "default": "./dist/media.contract.test.js"
      },
      "./migrations.contract.test": {
        "types": "./dist/migrations.contract.test.d.ts",
        "default": "./dist/migrations.contract.test.js"
      },
      "./persistence.contract.test": {
        "types": "./dist/persistence.contract.test.d.ts",
        "default": "./dist/persistence.contract.test.js"
      },
      "./renderer.contract.test": {
        "types": "./dist/renderer.contract.test.d.ts",
        "default": "./dist/renderer.contract.test.js"
      },
      "./revisions.contract.test": {
        "types": "./dist/revisions.contract.test.d.ts",
        "default": "./dist/revisions.contract.test.js"
      },
      "./site.contract.test": {
