{
  "name": "@michaelthielemann/kestrel-contracts",
  "version": "5.2.0",
  "description": "Kestrel standard contracts (persistence, authn, authz, blobstore, events) with contract test suites.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@michaelthielemann/kestrel": "workspace:^",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@michaelthielemann/kestrel": "workspace:*",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues"
}
