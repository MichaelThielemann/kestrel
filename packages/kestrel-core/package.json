{
  "name": "@kestrel/core",
  "version": "0.1.0",
  "description": "Kestrel's server domain code: content model types, field-type/block registries, schema-building pure functions, and request-scoped read primitives.",
  "license": "Apache-2.0",
  "author": "Michael Thielemann <283621694+MichaelThielemann@users.noreply.github.com>",
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/kestrel-core"
  },
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "sideEffects": [
    "./dist/server/pipeline/defaults.js",
    "./dist/server/utils/registry.js"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "@kestrel/contracts": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "effect": "~3.22.1",
    "nanoid": "^5.1.16",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "h3": "^1.15.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@kestrel/access": "workspace:*",
    "@kestrel/media": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "fast-check": "^4.9.0",
    "h3": "^1.15.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
