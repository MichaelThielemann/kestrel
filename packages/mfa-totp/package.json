{
  "name": "@michaelthielemann/kestrel-mfa-totp",
  "version": "5.8.1",
  "description": "A second factor for any authn@1 module: time-based one-time codes (RFC 6238) with recovery codes, stored via persistence@1.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./module.ts",
    "./impl": "./impl.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/module.d.ts",
        "default": "./dist/module.js"
      },
      "./impl": {
        "types": "./dist/impl.d.ts",
        "default": "./dist/impl.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@michaelthielemann/kestrel": "workspace:^",
    "@michaelthielemann/kestrel-contracts": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@michaelthielemann/kestrel": "workspace:*",
    "@michaelthielemann/kestrel-authn-multi": "workspace:*",
    "@michaelthielemann/kestrel-authz-roles": "workspace:*",
    "@michaelthielemann/kestrel-contracts": "workspace:*",
    "@michaelthielemann/kestrel-persistence-sqlite": "workspace:*",
    "@michaelthielemann/kestrel-ratelimit-memory": "workspace:*",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/mfa-totp"
  },
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues"
}
