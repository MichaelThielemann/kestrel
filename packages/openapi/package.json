{
  "name": "@michaelthielemann/kestrel-openapi",
  "version": "5.1.0",
  "description": "Generates an OpenAPI 3.1 description from a booted Kestrel instance (triggers, pipelines, step descriptions).",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "kestrel-openapi": "./cli.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "kestrel-openapi": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@michaelthielemann/kestrel": "workspace:^"
  },
  "devDependencies": {
    "@michaelthielemann/kestrel": "workspace:*",
    "vitest": "^3.2.0",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelThielemann/kestrel.git",
    "directory": "packages/openapi"
  },
  "homepage": "https://github.com/MichaelThielemann/kestrel#readme",
  "bugs": "https://github.com/MichaelThielemann/kestrel/issues"
}
