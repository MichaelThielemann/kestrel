{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by kestrel-web from app/blocks/*.vue on every build - do not edit",
  "$id": "pages.body",
  "type": "array",
  "items": {
    "$ref": "#/$defs/node"
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/columns"
        },
        {
          "$ref": "#/$defs/hero"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/prose"
        }
      ]
    },
    "columns": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "columns"
        },
        "props": {
          "type": "object",
          "properties": {
            "ratio": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "1-1",
                    "2-1",
                    "1-2"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "properties": {
            "left": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "right": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "hero"
        },
        "props": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string"
            },
            "image": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cta": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "internal",
                        "external",
                        "email",
                        "tel"
                      ]
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "heading"
          ],
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "image"
        },
        "props": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "alt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "caption": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "image"
          ],
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "prose": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "prose"
        },
        "props": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "format": "html"
            }
          },
          "required": [
            "body"
          ],
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
