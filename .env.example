# The auth vars are read per request; every other KESTREL_* below is read once when the app is BUILT
# (dev start / build / generate) and frozen into runtimeConfig — setting one in front of an already-built
# server has no effect. Retune a prebuilt server with the NUXT_* runtimeConfig names instead
# (NUXT_KESTREL_DB_PATH, NUXT_MEDIA_LOCAL_DIR, …) — see docs/guide/configuration.md.

# Session signing secret (>= 32 bytes). Generate: openssl rand -base64 32
KESTREL_SESSION_SECRET=
# Admin password hash. Generate: pnpm hash-password "your-password"
KESTREL_ADMIN_PASSWORD_HASH=
# Optional: set to 'false' ONLY for plain-HTTP dev (drops __Host- prefix + Secure)
# KESTREL_SECURE_COOKIES=true
# Optional: session lifetime in seconds (default 604800 = 7 days)
# KESTREL_SESSION_MAX_AGE=604800

# Media (optional; shown here at the built-in defaults). Any KESTREL_* uncommented below OVERRIDES the
# equivalent kestrel.config.ts media setting — leave commented to configure media in kestrel.config.ts instead.
# KESTREL_MEDIA_DRIVER=local
# KESTREL_MEDIA_LOCAL_DIR=.data/uploads
# KESTREL_MEDIA_BASE_URL=/uploads
# KESTREL_MEDIA_MAX_BYTES=26214400
# Upload allow-list: comma-separated MIME types; empty = built-in default (images, pdf,
# Office/OpenDocument, common video + audio). See docs/guide/media.md. A rejected upload's
# 415 message shows the detected MIME to add.
# KESTREL_MEDIA_ALLOWED_MIME=
