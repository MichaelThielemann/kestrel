{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.slug.config.ts"
  },
  "mutate": [
    "packages/kestrel-core/src/app/utils/slugify.ts",
    "packages/kestrel-core/src/server/utils/page-slug.ts",
    "packages/kestrel-core/src/server/utils/page-route.ts"
  ],
  "ignorePatterns": ["dist", ".output", "playground", "docs", "graphify-out", ".desk", "test/e2e", "extensions"],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": ".stryker-tmp/slug.incremental.json",
  "tempDirName": ".stryker-tmp/slug",
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/slug/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/slug/mutation-report.json"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 71
  },
  "timeoutMS": 15000,
  "concurrency": 4
}
