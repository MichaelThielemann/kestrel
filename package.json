{
  "name": "kestrel-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "scripts": {
    "start": "pnpm --filter kestrel-example-minimal start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:s3": "node scripts/s3-minio.mjs",
    "test:contracts": "vitest run impl.test",
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "docs:generate": "node --disable-warning=ExperimentalWarning scripts/docs.ts",
    "docs:check": "node --disable-warning=ExperimentalWarning scripts/docs.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.5.0",
    "eslint": "^10.9.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zod": "^4.6.6"
  }
}
